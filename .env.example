# Banco de dados (PostgreSQL). Em desenvolvimento, se ficar vazio, usa PGlite em .data/pglite
DATABASE_URL=postgres://usuario:senha@localhost:5432/eneven_agenda

# URL pública da aplicação (obrigatória em produção: monta o retorno do Google e os links dos e-mails)
APP_URL=http://localhost:3000

# Segredo das sessões e dos cookies assinados (gere com: openssl rand -hex 32).
# Obrigatório em produção e sempre que APP_URL for https.
SESSION_SECRET=

# Entrar com o Google (opcional: sem os dois, o botão não aparece). Veja o README
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail transacional (ZeptoMail). Sem ZEPTOMAIL_TOKEN o e-mail só aparece no console
# (em produção, sem o token, o envio falha). O token pode ser colado com ou sem o
# prefixo "Zoho-enczapikey ".
ZEPTOMAIL_TOKEN=
# Endereço da API de envio (host que o painel do agente "Eneven-Agenda" mostra)
ZEPTOMAIL_URL=https://cpaas.zoho.com/v1.1/email
EMAIL_FROM=nao-responda@eneven.com.br

# Textos legais (/termos e /privacidade). Vazios, valem os padrões entre parênteses;
# o documento (CPF ou CNPJ) é omitido quando vazio.
# Responsável pela plataforma (padrão: Ricardo Santos)
LEGAL_OWNER_NAME=
# CPF ou CNPJ do responsável (opcional)
LEGAL_OWNER_DOC=
# E-mail de contato e do encarregado de dados (padrão: eneventech@gmail.com)
LEGAL_CONTACT_EMAIL=
