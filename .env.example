# Banco de dados (PostgreSQL). Em desenvolvimento, se ficar vazio, usa PGlite em .data/pglite
DATABASE_URL=postgres://usuario:senha@localhost:5432/eneven_agenda

# URL pública da aplicação (obrigatória em produção: monta o retorno do Google e os links dos e-mails)
APP_URL=http://localhost:3000

# Segredo das sessões e dos cookies assinados (gere com: openssl rand -hex 32).
# Obrigatório em produção e sempre que APP_URL for https.
SESSION_SECRET=

# Entrar com o Google (opcional: sem os dois, o botão não aparece). Veja o README
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail transacional (ZeptoMail). Sem ZEPTOMAIL_TOKEN o e-mail só aparece no console
# (em produção, sem o token, o envio falha). O token pode ser colado com ou sem o
# prefixo "Zoho-enczapikey ".
ZEPTOMAIL_TOKEN=
# Endereço da API de envio (host que o painel do agente "Eneven-Agenda" mostra)
ZEPTOMAIL_URL=https://cpaas.zoho.com/v1.1/email
EMAIL_FROM=nao-responda@eneven.com.br

# Textos legais (/termos e /privacidade). Vazios, valem os padrões entre parênteses;
# o documento (CPF ou CNPJ) é omitido quando vazio.
# Responsável pela plataforma (padrão: Ricardo Santos)
LEGAL_OWNER_NAME=
# CPF ou CNPJ do responsável (opcional)
LEGAL_OWNER_DOC=
# E-mail de contato e do encarregado de dados (padrão: eneventech@gmail.com)
LEGAL_CONTACT_EMAIL=

# WhatsApp de suporte da Eneven (opcional, só números com 55 e DDD, ex.: 5511999999999).
# Com ele, a faixa de "somente leitura" do painel mostra o botão "Falar com a Eneven".
SUPPORT_WHATSAPP=

# WhatsApp Cloud API oficial (servidor). Sem credenciais, produção não envia.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Segredo do endpoint POST /api/cron/whatsapp (Bearer). Sem ele, o cron fica desligado.
CRON_SECRET=

# Mercado Pago: somente para desenvolvimento do Plano 5; não ativar cobrança em produção.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_COLLECTOR_ID=
MERCADO_PAGO_LIVE_MODE=false
MERCADO_PAGO_WEBHOOK_SECRET=
# Stripe (cartão, opcional): chave secreta e segredo do webhook (endpoint /api/webhooks/stripe).
# Fora da produção só vale chave de teste (sk_test_). Em produção, STRIPE_LIVE_MODE=true exige sk_live_.
# Sem as duas variáveis a Stripe não aparece como opção no painel do superadmin.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
# Avisos de cobrança: somente em teste e para o endereço de teste informado.
BILLING_NOTICE_TEST_ENABLED=false
BILLING_NOTICE_TEST_RECIPIENT=
